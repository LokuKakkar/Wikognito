# =============================================================================
# Wikognito — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values before starting the app:
#   cp .env.example .env
#
# Columns in this catalog:
#   REQUIRED  — process fails to start if missing (or invalid in production)
#   OPTIONAL  — has a safe default
#   SECRET    — server-only; never commit real values or expose via NEXT_PUBLIC_*
#   PUBLIC    — safe to send to the browser
# =============================================================================

# REQUIRED, public — runtime mode: development | test | production
NODE_ENV=development

# REQUIRED, secret — PostgreSQL connection (matches local Docker Compose)
# Example: postgresql://USER:PASSWORD@HOST:5433/redactle
DATABASE_URL=postgresql://redactle:redactle_dev@localhost:5433/redactle

# REQUIRED, secret — Redis connection (matches local Docker Compose)
# Example: redis://localhost:6380
REDIS_URL=redis://localhost:6380

# OPTIONAL, public — Fastify listen port when PORT is unset (default: 4000)
BACKEND_PORT=4000

# OPTIONAL, public — platform listen port. Render sets this. When set, it overrides BACKEND_PORT.
# Do not set this locally unless you intend to replace BACKEND_PORT.
# PORT=

# OPTIONAL, public — listen address (default: 0.0.0.0). Leave unset locally and on Render.
# HOST=

# REQUIRED, public — Frontend → backend base URL (browser-visible)
# Example: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# OPTIONAL, public — session cookie name (default: redactle_session)
# Internal identifier; do not rename in production without a migration plan.
SESSION_COOKIE_NAME=redactle_session

# OPTIONAL, public — Redis session TTL in seconds (default: 30 days)
SESSION_TTL_SECONDS=2592000

# OPTIONAL, public — article source label logged at startup: LOCAL | WIKIPEDIA
ARTICLE_SOURCE=LOCAL

# OPTIONAL, public — Wikipedia MediaWiki API (admin import / CLI, not gameplay)
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# OPTIONAL, public — Wikimedia rejects empty or generic browser UAs.
# Example: Wikognito/1.0 (contact@example.com)
WIKIPEDIA_USER_AGENT="Wikognito/1.0 (contact@example.com)"

# OPTIONAL, public — delay between batch Wikipedia fetches (milliseconds)
WIKIPEDIA_REQUEST_DELAY_MS=500

# OPTIONAL, public — directory for Wikipedia article JSON snapshots
# Default: <repo>/data/wikipedia-articles
# ARTICLE_BACKUP_DIR=/home/you/.local/share/wikognito/wikipedia-articles

# OPTIONAL, public — puzzle generator version stamped on generated puzzles
PUZZLE_GENERATOR_VERSION=2.0.0

# OPTIONAL, secret — Google OAuth (required only for Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL, public — Google OAuth callback on the backend
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# OPTIONAL in development, REQUIRED (non-localhost) in production, public
# Used for CORS allowlist, OAuth return, and email links.
FRONTEND_ORIGIN=http://localhost:3002

# OPTIONAL, secret — SMTP URL for verification / password-reset email
# Empty = log mail to the console. Production mail provider is out of scope.
SMTP_URL=

# OPTIONAL, secret — comma-separated Google emails that receive ADMIN on login
GOOGLE_ADMIN_EMAILS=you@gmail.com,admin@redactle.local

# OPTIONAL, public — structured log verbosity: debug | info | warn | error
LOG_LEVEL=info

# OPTIONAL, secret — Bearer token for POST /api/internal/puzzles/publish-today
# Leave empty to disable the HTTP publish fallback (CLI still works).
PUBLISH_SECRET=

# OPTIONAL, public — set false to disable HTTP rate limiting
# RATE_LIMIT_ENABLED=true

# OPTIONAL, public — requests per minute (defaults shown)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GAME_MAX=60
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_PUBLIC_MAX=120

# OPTIONAL, public — illustration pack for the six decorative slots.
# `none` (also the default when unset) | `v1` legacy mascot art.
# Phase 9D places detective artwork from `public/assets/detective/` directly
# on archive/profile/leaderboard/howto. Leave this at `none` so the v1
# mascots do not clash with the desk.
NEXT_PUBLIC_ILLUSTRATIONS_PACK=none
