# Production env catalog (names only). Copy to .env.prod (git-ignored, chmod 600) and fill in.
# Used with: docker compose --env-file .env.prod -f infrastructure/docker/docker-compose.prod.yml ...
# Generate secrets with: openssl rand -hex 32

# --- Compose / Caddy / frontend build ---------------------------------------------------
# Public hostname Caddy serves (Let's Encrypt). Local test: wikognito.localtest.me
SITE_ADDRESS=wikognito.duckdns.org
# Local test only: CADDY_TLS=tls internal (self-signed). Leave empty on the server.
CADDY_TLS=
# Inlined into the frontend at BUILD time. Same origin as the page, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://wikognito.duckdns.org
NEXT_PUBLIC_ILLUSTRATIONS_PACK=none
# Host directories mounted into the backend container (articles snapshots, dossier JSON).
ARTICLES_DIR=/srv/wikognito/articles
CORPUS_DIR=/srv/wikognito/corpus

# --- Postgres container (must match DATABASE_URL) ---------------------------------------
POSTGRES_USER=wikognito
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wikognito

# --- Backend ----------------------------------------------------------------------------
NODE_ENV=production
DATABASE_URL=postgresql://wikognito:change-me@postgres:5432/wikognito
REDIS_URL=redis://redis:6379
# Must equal the page origin exactly (scheme + host, no trailing slash), never localhost.
FRONTEND_ORIGIN=https://wikognito.duckdns.org
# Frontend and API share one origin, so the cookie can be first-party.
SESSION_COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wikognito.duckdns.org/api/auth/google/callback
# Comma-separated Google emails that receive ADMIN on login
GOOGLE_ADMIN_EMAILS=

# Empty = password-reset mail is logged to the backend container logs
SMTP_URL=
SMTP_FROM=

WIKIPEDIA_USER_AGENT=Wikognito/1.0 (https://wikognito.duckdns.org; you@example.com)
LOG_LEVEL=info
# Optional; empty disables the HTTP publish route (the API self-publishes daily).
PUBLISH_SECRET=

# --- Abuse limits (per client IP, per minute; defaults shown, usually leave unset) ---------
# RATE_LIMIT_AUTH_MAX=30          login / register / password reset (scrypt is CPU heavy)
# RATE_LIMIT_GAME_MAX=300         session sync and game completion
# RATE_LIMIT_PUBLIC_MAX=600       everything else under /api
# RATE_LIMIT_ADMIN_MAX=30
# RATE_LIMIT_NEW_SESSION_MAX=600  brand-new anonymous sessions per IP per 10 minutes
