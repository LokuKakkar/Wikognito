{
  "name": "@redactle/article-ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:dummy": "tsx src/cli/ingest-dummy.ts",
    "import:wikipedia": "tsx src/cli/import-wikipedia.ts",
    "articles:backup": "tsx src/cli/backup-articles.ts",
    "articles:restore": "tsx src/cli/restore-articles.ts",
    "puzzles:generate": "tsx src/cli/generate-puzzles.ts",
    "puzzles:validate": "tsx src/cli/validate-puzzles.ts",
    "puzzles:publish-today": "tsx src/cli/publish-today.ts",
    "corpus:process": "tsx src/cli/process-corpus.ts",
    "dossiers:seed": "tsx src/cli/seed-dossier.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@redactle/article-provider": "workspace:*",
    "@redactle/puzzle-engine": "workspace:*",
    "@redactle/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "ioredis": "^5.7.0",
    "wtf_wikipedia": "^10.4.2"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
