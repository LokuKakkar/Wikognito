    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@redactle/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "imagetracerjs": "^1.2.6",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
